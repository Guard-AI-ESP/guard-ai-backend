# Base de données SQLite
DATABASE_URL=sqlite://guard-ai.db

# Clé secrète JWT — changer en production (min. 32 caractères aléatoires)
JWT_SECRET=dev-insecure-secret-change-in-production

# Clé API pour les accès machine-to-machine (IoT, services) — optionnel
API_KEY=

# Port d'écoute du serveur
PORT=8080
